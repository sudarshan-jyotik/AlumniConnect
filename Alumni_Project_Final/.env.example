# Application Settings
APP_NAME=AlumniConnect
APP_VERSION=1.0.0
DEBUG=False

# Database (Provide DATABASE_URL on cloud platforms like Render, or individual fields for local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumniconnect
# Or individual fields:
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=alumniconnect
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT Authentication (Required: Generate a 32+ character random secret)
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Frontend URL on Vercel, e.g. https://your-project.vercel.app or comma-separated list)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=True

# Email (SMTP - Optional, for email verification & notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AlumniConnect

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
